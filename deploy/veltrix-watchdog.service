[Unit]
Description=Veltrix release-readiness watchdog
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/domain-drop-catcher/backend
EnvironmentFile=/opt/domain-drop-catcher/backend/.env
EnvironmentFile=/etc/veltrix-operations.env
ExecStart=/opt/domain-drop-catcher/backend/.venv/bin/python -m app.operations.watchdog
UMask=0077
TimeoutStartSec=2min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
StateDirectory=veltrix-watchdog
StateDirectoryMode=0700
ReadOnlyPaths=/opt/domain-drop-catcher/backend/.env /etc/veltrix-operations.env /etc/veltrix/known_hosts -/var/backups/domain-drop-catcher
ReadWritePaths=/var/lib/veltrix-watchdog
